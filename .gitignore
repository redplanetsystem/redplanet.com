# ==============================================================================
# RED PLANET ECOSYSTEM — GITIGNORE SPECIFICATION
# ==============================================================================

# 1. Environment & Sensitive Credentials (CRITICAL SECURITY)
.env
.env.local
.env.*.local
*.pem
secrets/

# 2. Next.js & Build Artifacts
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# 3. Dependencies & Package Managers
node_modules/
pnpm-lock.yaml
yarn.lock

# 4. OS & IDE Metadata Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*.iml

# 5. Vercel Deployment & Cloud Cache
.vercel/
.turbo/

# 6. Local Media Uploads & Dev Fallbacks
# (Production environments utilize Vercel Blob or AWS S3 cloud storage)
data/uploaded-tracks.json
public/audio/*
public/covers/*
!public/audio/.gitkeep
!public/audio/README.md
!public/covers/.gitkeep
!public/covers/README.md

# 7. Logs & Temporary System Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.eslintcache
.stylelintcache